# Postgres (por ejemplo Supabase → Project Settings → Database → Connection string, modo "Transaction pooler").
# Si no se define, la app usa PGlite (Postgres embebido) y guarda los datos en ./.data
DATABASE_URL=

# Código que hay que escribir para crear un grupo. Sin definir: en local se puede crear libremente;
# en Vercel la creación queda bloqueada hasta que se defina.
CODIGO_CREACION=
